{
  "$schema": "http://json.schemastore.org/template",
  "author": "Akka",
  "classifications": ["Akka.NET", "Akka.Cluster", "Web API","Cloud", "Service", "Web"],
  "name": "Akka.NET + Akka.Cluster + ASP.NET Core HTTP API",
  "description": "An out-of-the-box solution for creating an ASP.NET API integrated with Akka.NET, running on .NET Aspire.",
  "groupIdentity": "Akka.Cluster.WebApi",
  "identity": "Akka.Cluster.WebApi.CSharp",
  "shortName": "akka.cluster.webapi",
  "defaultName": "AkkaHttpApi1",
  "tags": {
    "language": "C#",
    "type": "solution"
  },
  "symbols": {
      "Discovery": {
      "type": "parameter",
      "description": "The cluster discovery backend used for Akka.Cluster bootstrap.",
      "datatype": "choice",
      "choices": [
        {
          "choice": "redis",
          "description": "Use Redis for cluster discovery (default)"
        },
        {
          "choice": "azure",
          "description": "Use Azure Table Storage for cluster discovery"
        }
      ],
      "replaces": "DiscoveryBackendParameter",
      "defaultValue": "redis"
    }
  },
  "sourceName": "WebApiTemplate",
  "preferNameDirectory": true,
  "primaryOutputs": [{ "path": "WebApiTemplate.slnx" }]
}
